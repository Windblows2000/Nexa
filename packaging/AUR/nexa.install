post_install() {
    echo ":: Nexa has been installed successfully."
    echo ":: To enable and start the media daemon for your user session, run:"
    echo "    systemctl --user enable --now nexad.service"
}

post_upgrade() {
    echo ":: Nexa has been updated."
    echo ":: If the daemon is running, you may want to restart your user service:"
    echo "    systemctl --user daemon-reload"
    echo "    systemctl --user restart nexad.service"
}

post_remove() {
    echo ":: Nexa has been removed."
    echo ":: You may want to stop and disable the service if you haven't already:"
    echo "    systemctl --user disable --now nexad.service"
}
